rules_version = '2';

// Sync (SYNC_ROADMAP.md). Fase 2: niega todo — todavía no hay nada que leer o escribir en
// Firestore. Las reglas reales de users/{uid} llegan en la Fase 3, y spaces/{id}/inviteCodes en
// la Fase 4 (diseño de referencia en my-wallet-app/firestore.rules). Tests:
// firestore-tests/rules.test.ts (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
